<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.bunnysframelab.caption"
                   ExtensionBundleVersion="1.2.0"
                   ExtensionBundleName="Bunnys Caption"
                   Version="11.0">
    <Author>Bunnys Framelab</Author>
    <Contact mailto="">https://www.instagram.com/bunnysframelab</Contact>
    <ExtensionList>
        <Extension Id="com.bunnysframelab.caption.panel" Version="1.2.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PPRO" Version="[23.0,99.9]"/>
            <Host Name="AEFT" Version="[23.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.bunnysframelab.caption.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Bunnys Caption</Menu>
                    <Geometry>
                        <Size><Width>420</Width><Height>760</Height></Size>
                        <MinSize><Width>320</Width><Height>420</Height></MinSize>
                        <MaxSize><Width>1400</Width><Height>2400</Height></MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./assets/icon_23.png</Icon>
                        <Icon Type="RollOver">./assets/icon_23.png</Icon>
                        <Icon Type="DarkNormal">./assets/icon_23.png</Icon>
                        <Icon Type="DarkRollOver">./assets/icon_23.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
